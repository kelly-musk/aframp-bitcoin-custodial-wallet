# Network: regtest | testnet | signet  (mainnet is intentionally not supported)
NETWORK=testnet

# Local directory for the seed file, descriptor-kind marker, and SQLite wallet DB.
# Must NOT be committed (see .gitignore).
DATA_DIR=./data

# Bitcoin Core-compatible RPC endpoint.
#   - Local regtest (for development): http://127.0.0.1:18443
#   - Your own testnet-indexing node: fill in its URL below.
BITCOIN_RPC_URL=

# Auth option A: user/pass
BITCOIN_RPC_USER=
BITCOIN_RPC_PASS=

# Auth option B: path to a Bitcoin Core cookie file (local regtest only), e.g.
# ~/.bitcoin/regtest/.cookie — leave USER/PASS blank if using this instead.
BITCOIN_RPC_COOKIE_FILE=
