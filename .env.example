# Network: regtest | testnet | signet | bitcoin (mainnet) — see README before using bitcoin.
NETWORK=testnet

# Local directory for named wallets (data/<name>/{seed.txt,kind.txt,wallet.sqlite}) and the
# .active marker. Must NOT be committed (see .gitignore).
DATA_DIR=./data

# Bitcoin Core-compatible RPC endpoint.
#   - Local regtest (for development): http://127.0.0.1:18443
#   - Your own testnet-indexing node: fill in its URL below.
#   - A hosted proxy like BitRPC: the *full* path it documents, e.g.
#     https://bitrpc.thebuidl.xyz/bitcoin (not just the bare host) — use auth option C below.
BITCOIN_RPC_URL=

# Auth option A: user/pass (plain Bitcoin Core)
BITCOIN_RPC_USER=
BITCOIN_RPC_PASS=

# Auth option B: path to a Bitcoin Core cookie file (local regtest only), e.g.
# ~/.bitcoin/regtest/.cookie — leave USER/PASS blank if using this instead.
BITCOIN_RPC_COOKIE_FILE=

# Auth option C: API key sent as an X-API-Key header, for a proxy that gates access that way
# (e.g. BitRPC) instead of Basic Auth. Leave USER/PASS/COOKIE_FILE blank if using this.
BITCOIN_RPC_API_KEY=
